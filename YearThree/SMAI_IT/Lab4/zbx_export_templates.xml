            <items>
                <item>
                    <uuid>3b42486e7d48465bb997f325bfbc50fe</uuid>
                    <name>RAM Used % / CPU Load  avg5</name>
                    <type>CALCULATED</type>
                    <key>cpu_ram_load</key>
                    <params>last(//vm.memory.size[pused]) / last(//system.cpu.load[all,avg5])</params>
                </item>
                <item>
                    <uuid>677c229713bb4a25813fa2693d55fbbb</uuid>
                    <name>Network Traffic in</name>
                    <key>net.if.in[eth0]</key>
                </item>
                <item>
                    <uuid>ae68c53e28cc4173bcab5fcca27937ba</uuid>
                    <name>Network Traffic out</name>
                    <key>net.if.out[eth0]</key>
                </item>
                <item>
                    <uuid>9532455a8425402397130ade2734c642</uuid>
                    <name>CPU Load avg1</name>
                    <key>system.cpu.load[all,avg1]</key>
                    <value_type>FLOAT</value_type>
                    <triggers>
                        <trigger>
                            <uuid>4713daae8e1446b7a99d289c4cc9d2d4</uuid>
                            <expression>max(/Template IT-System-Monitoring/system.cpu.load[all,avg1],5m)&gt;2</expression>
                            <name>High load</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>c0b96455920349449b73b1e82858fdb2</uuid>
